---
import Base from '../layouts/Base.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import { FORM_URL } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/brand/${f}`;
const ano = new Date().getFullYear();

const tex = (s: string) => katex.renderToString(s, { throwOnError: true, output: 'html' });
const formula = tex('A = \\pi r^{2}');
const conta = tex('A = 3 \\cdot 4^{2} = 3 \\cdot 16 = 48\\ \\text{m}^{2}');

const alternativas = [
  { l: 'A', t: '24 m²', nota: 'Esse valor vem de 2πr, que é o comprimento da borda, não a área.' },
  { l: 'B', t: '32 m²', nota: 'Esse valor vem de 2r², que não corresponde à área do círculo.' },
  { l: 'C', t: '48 m²', nota: 'Correta: 3 · 4² = 48.' },
  { l: 'D', t: '96 m²', nota: 'Esse valor vem de multiplicar por 2 o resultado correto.' },
  { l: 'E', t: '192 m²', nota: 'Esse valor vem de usar o diâmetro no lugar do raio: 3 · 8² = 192.' },
];

const passos = [
  { n: '1', t: 'Você define', d: 'Escolha a habilidade, o assunto e o nível de dificuldade. A trIA sugere questões a partir do que você pediu.' },
  { n: '2', t: 'Você revisa', d: 'Cada questão traz gabarito, resolução e fonte à vista. O que ainda não foi verificado aparece marcado como pendente.' },
  { n: '3', t: 'Você decide', d: 'Ajuste o enunciado, troque alternativas, monte o simulado e assine. O material é seu.' },
];

const compromissos = [
  { t: 'Autonomia', d: 'O professor conduz as escolhas pedagógicas. A trIA é uma assinatura discreta; o protagonista é o seu material.' },
  { t: 'Rigor', d: 'Conteúdo, gabaritos e resoluções precisam de evidências e verificações, e isso fica visível.' },
  { t: 'Transparência', d: 'Fontes, limitações e pendências aparecem na tela. Quando algo não foi verificado, dizemos.' },
  { t: 'Acesso', d: 'Ampliar a capacidade de produzir material próprio de qualidade, com leitura fácil e versão para xerox.' },
];
---

<Base>
  <header class="topo on-dark">
    <div class="wrap topo-in">
      <a href={`${base}/`} aria-label="trIA, página inicial">
        <img src={img('trIA-principal-negativo.svg')} alt="trIA" width="112" height="54" />
      </a>
      <a class="topo-link" href="#lista">Lista de espera</a>
    </div>
  </header>

  <main id="conteudo">
    <!-- 1. Abertura -->
    <section class="hero on-dark">
      <div class="wrap hero-in">
        <span class="linha-azul"></span>
        <p class="chip">Em desenvolvimento · começando por Matemática e Ciências da Natureza</p>
        <h1>Questões e simulados no padrão ENEM, criados com o <span class="bloco">professor</span>.</h1>
        <p class="hero-sub">
          A trIA ajuda você a transformar objetivos de aprendizagem em questões que você consegue
          compreender, verificar, adaptar e assumir como suas.
        </p>
        <div class="acoes">
          {FORM_URL
            ? <a class="btn btn-claro" href={FORM_URL} rel="noopener">Quero ser avisado</a>
            : <a class="btn btn-claro" href="#lista">Quero ser avisado</a>}
          <a class="btn btn-contorno" href="#exemplo">Ver uma questão de exemplo</a>
        </div>
      </div>
    </section>

    <!-- 2. Questão de exemplo -->
    <section class="sec" id="exemplo" aria-labelledby="t-exemplo">
      <div class="wrap">
        <span class="linha-azul"></span>
        <p class="eyebrow">Como a trIA mostra o material</p>
        <h2 id="t-exemplo">Cada questão vem com a sua base à vista</h2>
        <p class="lead">
          Este é um exemplo ilustrativo, feito para mostrar o formato. Gabarito, resolução e fonte ficam
          ao lado do enunciado para você conferir antes de usar.
        </p>

        <article class="questao" aria-label="Questão de exemplo">
          <p class="meta">Matemática · Geometria plana · Padrão ENEM · Habilidade H8 <span class="ilustrativo">exemplo ilustrativo</span></p>
          <p class="enunciado">
            Uma escola vai revestir com piso emborrachado um pátio circular de 4 m de raio. Adote{' '}
            <span set:html={tex('\\pi = 3')} />{' '}e lembre que a área do círculo é{' '}
            <span set:html={formula} />. Quantos metros quadrados de piso serão necessários?
          </p>
          <ol class="alts">
            {alternativas.map((a) => (
              <li><span class="bola" aria-hidden="true">{a.l}</span><span class="sr">Alternativa {a.l}: </span>{a.t}</li>
            ))}
          </ol>

          <details class="resolucao">
            <summary>Ver gabarito e resolução</summary>
            <div class="res-corpo">
              <ul class="selos">
                <li class="selo selo-ok"><span aria-hidden="true">✓</span> Gabarito verificado</li>
                <li class="selo selo-pend"><span aria-hidden="true">!</span> Revisão do professor pendente</li>
                <li class="selo selo-fonte"><span aria-hidden="true">§</span> Fonte citada</li>
              </ul>
              <p><strong>Gabarito: C.</strong> Substituindo o raio na fórmula da área:</p>
              <p class="conta" set:html={conta} />
              <ul class="porques">
                {alternativas.filter((a) => a.l !== 'C').map((a) => (
                  <li><strong>{a.l}.</strong> {a.nota}</li>
                ))}
              </ul>
            </div>
          </details>
        </article>
        <p class="nota">Os três selos mostram como o estado de cada questão aparece, sempre com ícone e texto. Nesta página eles servem apenas de demonstração.</p>
      </div>
    </section>

    <!-- 3. Como funciona -->
    <section class="sec sec-nevoa" id="como" aria-labelledby="t-como">
      <div class="wrap">
        <span class="linha-azul"></span>
        <p class="eyebrow">Como funciona</p>
        <h2 id="t-como">Três passos, e o professor conduz todos</h2>
        <ol class="passos">
          {passos.map((p) => (
            <li>
              <span class="passo-n" aria-hidden="true">{p.n}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. Compromissos -->
    <section class="sec" id="compromissos" aria-labelledby="t-comp">
      <div class="wrap">
        <span class="linha-azul"></span>
        <p class="eyebrow">Quatro compromissos</p>
        <h2 id="t-comp">Clareza para ensinar, evidência para confiar</h2>
        <ul class="cards">
          {compromissos.map((c) => (
            <li><h3>{c.t}</h3><p>{c.d}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. O nome -->
    <section class="sec sec-nevoa" id="nome" aria-labelledby="t-nome">
      <div class="wrap duas">
        <div>
          <span class="linha-azul"></span>
          <p class="eyebrow">O nome</p>
          <h2 id="t-nome">Um “I” que pertence às duas palavras</h2>
          <p class="lead">
            <strong>trIA</strong> junta <strong>TRI</strong>, a Teoria de Resposta ao Item, método de nota do ENEM,
            e <strong>IA</strong>, a inteligência artificial. O “I” fecha uma e abre a outra: é o ponto de encontro
            entre o método e a tecnologia.
          </p>
          <p class="lead">
            E também lembra <em>triar</em>: selecionar, filtrar, escolher o que entra na prova. É exatamente o que o
            professor faz ao montar um simulado.
          </p>
        </div>
        <img class="logo-rot" src={img('trIA-conceitual-com-rotulos.svg')} alt="Logo trIA com os rótulos: TRI, Teoria de Resposta ao Item, e IA, Inteligência Artificial" width="520" height="276" loading="lazy" />
      </div>
    </section>

    <!-- 6. Xerox -->
    <section class="sec" id="xerox" aria-labelledby="t-xerox">
      <div class="wrap duas">
        <img class="a4" src={img('cabecalho-simulado-A4.png')} alt="Modelo de simulado em A4, em preto e branco, com cabeçalho, campos de nome, turma e data, e questões em duas colunas" width="420" height="594" loading="lazy" />
        <div>
          <span class="linha-azul"></span>
          <p class="eyebrow">Pronto para a sala de aula</p>
          <h2 id="t-xerox">Simulado que sai bem na copiadora</h2>
          <p class="lead">
            O modelo de simulado da trIA é só preto, com fonte de leitura e diagramação de prova. Pensado para
            xerox comum, porque o material precisa funcionar na escola real.
          </p>
          <p class="lead">No rodapé, uma assinatura simples: <em>Material criado pelo professor com apoio da trIA.</em></p>
        </div>
      </div>
    </section>

    <!-- 7. Lista de espera -->
    <section class="lista on-dark" id="lista" aria-labelledby="t-lista">
      <div class="wrap lista-in">
        <span class="linha-azul"></span>
        <h2 id="t-lista">Quer ser avisado quando a trIA abrir?</h2>
        <p class="lead">
          Deixe seu contato na lista de espera. Avisamos quando houver novidades e, se quiser, convidamos
          você para testar com a gente.
        </p>
        {FORM_URL
          ? <a class="btn btn-claro" href={FORM_URL} rel="noopener">Entrar na lista de espera</a>
          : <span class="btn btn-claro" role="link" aria-disabled="true">Formulário em preparação</span>}
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="wrap rodape-in">
      <img src={img('trIA-principal-positivo.svg')} alt="trIA" width="96" height="46" />
      <p class="frase">Inteligência para criar. Clareza para ensinar. Autonomia para transformar.</p>
      <p class="mini">Material criado pelo professor com apoio da trIA. © {ano} trIA. ENEM é marca do INEP; a trIA não é afiliada ao INEP.</p>
    </div>
  </footer>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* topo */
  .topo { background: var(--tria-marinho); }
  .topo-in { display: flex; align-items: center; justify-content: space-between; padding-block: 18px; }
  .topo-link { color: #fff; font-weight: 700; text-decoration: none; border-bottom: 2px solid transparent; }
  .topo-link:hover { border-color: #fff; }

  /* abertura */
  .hero { background: var(--tria-marinho); color: #fff; padding-block: clamp(48px, 10vw, 112px) clamp(56px, 10vw, 120px); }
  .hero-in { max-width: 820px; margin-left: max(var(--pad), calc((100% - var(--max)) / 2)); margin-right: auto; width: auto; }
  .chip { display: inline-block; font-size: 0.9375rem; color: #DCE3F1; border: 1px solid rgba(255,255,255,.35); padding: 4px 12px; margin-bottom: 24px; }
  .hero h1 { margin-bottom: 24px; }
  .hero-sub { font-size: 1.25rem; color: #E6EBF5; max-width: 640px; margin-bottom: 36px; }
  .acoes { display: flex; flex-wrap: wrap; gap: 14px; }

  /* seções */
  .sec { padding-block: clamp(56px, 9vw, 96px); }
  .sec-nevoa { background: var(--tria-nevoa); }
  .sec h2 { margin: 6px 0 16px; max-width: 760px; }
  .lead { font-size: 1.1875rem; max-width: 640px; }
  .lead + .lead { margin-top: 14px; }
  .duas { display: grid; gap: clamp(28px, 6vw, 64px); align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .duas { grid-template-columns: 1fr 1fr; } }
  .logo-rot { width: 100%; max-width: 520px; justify-self: center; }
  .a4 { width: 100%; max-width: 380px; justify-self: center; border: 1px solid var(--tria-linha); background: #fff; box-shadow: none; }

  /* questão */
  .questao { margin-top: 36px; background: #fff; border: 1px solid var(--tria-linha); padding: clamp(20px, 4vw, 40px); max-width: 760px; }
  .meta { font-size: 0.875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--tria-texto-2); margin-bottom: 18px; }
  .ilustrativo { text-transform: none; letter-spacing: 0; font-weight: 400; border: 1px solid var(--tria-linha); padding: 1px 8px; margin-left: 6px; white-space: nowrap; }
  .enunciado { font-family: var(--f-questao); font-size: 1.1875rem; line-height: 1.65; margin-bottom: 22px; }
  .alts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-family: var(--f-questao); font-size: 1.1875rem; }
  .alts li { display: flex; align-items: center; gap: 14px; }
  .bola { flex: none; width: 36px; height: 36px; border: 2px solid var(--tria-marinho); border-radius: 50%; display: grid; place-items: center; font-family: var(--f-texto); font-weight: 700; font-size: 0.9375rem; }
  .resolucao { margin-top: 28px; border-top: 1px solid var(--tria-linha); padding-top: 18px; }
  .resolucao summary { cursor: pointer; font-weight: 700; color: var(--tria-azul); }
  .res-corpo { margin-top: 16px; display: grid; gap: 14px; font-family: var(--f-questao); }
  .res-corpo .selos { font-family: var(--f-texto); }
  .selos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .selo { font-size: 0.9375rem; font-weight: 700; padding: 3px 10px; border: 1.5px solid currentColor; }
  .selo-ok { color: var(--tria-verificado); }
  .selo-pend { color: var(--tria-pendente); }
  .selo-fonte { color: var(--tria-fonte); }
  .conta { font-size: 1.25rem; overflow-x: auto; }
  .porques { margin: 0; padding-left: 1.2em; color: var(--tria-texto-2); }
  .nota { margin-top: 14px; font-size: 0.9375rem; color: var(--tria-texto-2); max-width: 640px; }

  /* passos e cards */
  .passos { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .passos li { background: #fff; border: 1px solid var(--tria-linha); padding: 24px; }
  .passo-n { font-family: var(--f-marca); font-weight: 800; font-size: 2rem; color: var(--tria-azul); display: block; margin-bottom: 8px; }
  .passos h3 { margin-bottom: 8px; }
  .cards { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .cards li { background: var(--tria-nevoa); padding: 24px; border-top: 4px solid var(--tria-azul); }
  .cards h3 { margin-bottom: 8px; }

  /* lista de espera */
  .lista { background: var(--tria-marinho); color: #fff; padding-block: clamp(56px, 9vw, 96px); }
  .lista-in { max-width: 720px; margin-left: max(var(--pad), calc((100% - var(--max)) / 2)); margin-right: auto; width: auto; }
  .lista h2 { margin: 6px 0 16px; }
  .lista .lead { color: #E6EBF5; margin-bottom: 28px; }

  /* rodapé */
  .rodape { background: var(--tria-papel); border-top: 1px solid var(--tria-linha); padding-block: 40px; }
  .rodape-in { display: grid; gap: 16px; }
  .frase { font-family: var(--f-marca); font-weight: 800; font-size: 1.0625rem; }
  .mini { font-size: 0.875rem; color: var(--tria-texto-2); max-width: 680px; }
  .rodape-in::after { content: ''; display: block; height: 4px; width: 96px; background: var(--tria-vermelho); }
</style>
