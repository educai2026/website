---
import Base from '../layouts/Base.astro';
import Demo from '../components/Demo.astro';
import Atendimento from '../components/Atendimento.astro';
import { FORM_URL, MOCKUP } from '../config';
import { duvidas } from '../data/atendimento';
import { questoes } from '../data/questoes';
import { icone } from '../lib/icones';
import '../styles/pagina.css';
import logo from '../../trIA-identidade-visual/02-logo/svg/trIA-principal-positivo.svg?raw';
import logoRotulos from '../../trIA-identidade-visual/02-logo/svg/trIA-conceitual-com-rotulos.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inicio = MOCKUP ? '#topo' : `${base}/`;
const ano = new Date().getFullYear();

const passos = [
  { t: 'Você define', d: 'Habilidade, assunto e nível. As sugestões partem do que você pediu.' },
  { t: 'Você revisa', d: 'Gabarito, resolução e fonte ficam à vista. O que ainda não foi verificado aparece como pendente.' },
  { t: 'Você decide', d: 'Ajusta o texto, escolhe o que entra, monta a prova e imprime. O material é seu.' },
];

const compromissos = [
  { t: 'Autonomia', d: 'O professor conduz as escolhas pedagógicas. A trIA assina em letra pequena; o protagonista é o seu material.' },
  { t: 'Rigor', d: 'Conteúdo, gabaritos e resoluções precisam de evidências e verificações.' },
  { t: 'Transparência', d: 'Fontes, limitações e pendências aparecem na tela. Quando algo não foi verificado, dizemos.' },
  { t: 'Acesso', d: 'Leitura fácil, alto contraste e folha em preto para a copiadora, para que mais professores produzam material próprio.' },
];

// O rótulo do logo com rótulos precisa descrever o que a imagem mostra.
const logoRotulosAcessivel = logoRotulos
  .replace('aria-label="trIA"', 'aria-label="Logo trIA com os rótulos: TRI, Teoria de Resposta ao Item, e IA, Inteligência Artificial"')
  .replace('<title>trIA</title>', '');
---

<Base>
  <header class="topo" id="topo">
    <div class="wrap topo-in">
      <a class="topo-logo" href={inicio} aria-label="trIA, início da página"><Fragment set:html={logo} /></a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#demo">Demonstração</a>
        <a href="#como">Como funciona</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-solido btn-p" href={FORM_URL} target="_blank" rel="noopener">
        Lista de espera<span class="sr"> (abre o formulário em nova aba)</span>
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero">
      <div class="wrap">
        <span class="linha-azul" aria-hidden="true"></span>
        <h1>Questões e simulados no padrão ENEM, criados <span class="junto">com o <span class="bloco">professor</span>.</span></h1>
        <div class="hero-base">
          <div>
            <p class="hero-sub">
              Você escolhe a habilidade, revisa cada questão e monta o simulado. A trIA sugere, mostra o
              gabarito e avisa o que ainda falta conferir.
            </p>
            <p class="hero-nota">Em desenvolvimento. Começamos por Matemática e Ciências da Natureza.</p>
          </div>
          <div class="acoes">
            <a class="btn btn-solido" href="#demo">Testar a demonstração</a>
            <a class="btn btn-contorno" href={FORM_URL} target="_blank" rel="noopener">
              Entrar na lista de espera<span class="sr"> (abre o formulário em nova aba)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="palco no-escuro" id="demo" aria-labelledby="demo-t">
      <div class="wrap">
        <div class="palco-cab">
          <h2 id="demo-t" tabindex="-1">Monte um simulado agora, com questões de exemplo</h2>
          <p>
            São {questoes.length} questões prontas para você testar o caminho inteiro: escolher, revisar, ajustar e
            ver a folha. Nada do que você fizer aqui é salvo ou enviado.
          </p>
        </div>
        <Demo />
      </div>
    </section>

    <section class="sec" id="como" aria-labelledby="como-t">
      <div class="wrap">
        <h2 id="como-t">Como funciona</h2>
        <ol class="passos">
          {passos.map((p, i) => (
            <li>
              <span class="passo-n" aria-hidden="true">{i + 1}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec" aria-labelledby="comp-t">
      <div class="wrap duas">
        <div class="duas-lado">
          <h2 id="comp-t">Quatro compromissos</h2>
          <p>É o que a trIA promete a quem ensina.</p>
        </div>
        <dl class="compromissos">
          {compromissos.map((c) => (
            <div>
              <dt>{c.t}</dt>
              <dd>{c.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec" aria-labelledby="nome-t">
      <div class="wrap nome-grid">
        <div class="nome-logo"><Fragment set:html={logoRotulosAcessivel} /></div>
        <div class="nome-texto">
          <h2 id="nome-t">Por que trIA</h2>
          <p>
            O nome junta <strong>TRI</strong>, a Teoria de Resposta ao Item, método de nota do ENEM,
            e <strong>IA</strong>, a inteligência artificial. O “I” fecha uma e abre a outra.
          </p>
          <p>
            Também lembra <em>triar</em>: selecionar o que entra na prova, que é o que o professor faz ao montar
            um simulado.
          </p>
        </div>
      </div>
    </section>

    <section class="sec" id="duvidas" aria-labelledby="duvidas-t">
      <div class="wrap duas">
        <div class="duas-lado">
          <h2 id="duvidas-t">Dúvidas</h2>
          <p>Não achou a sua? O atendimento tem mais respostas.</p>
          <button type="button" class="btn btn-contorno btn-p" data-abrir-atendimento>
            <Fragment set:html={icone('conversa', 16)} />
            <span>Abrir atendimento</span>
          </button>
        </div>
        <div class="faq">
          {duvidas.filter((d) => d.naPagina).map((d) => (
            <details>
              <summary><span>{d.pergunta}</span><Fragment set:html={icone('abrir', 18)} /></summary>
              <p>{d.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="chamada no-escuro" id="lista" aria-labelledby="lista-t">
      <div class="wrap">
        <span class="linha-azul" aria-hidden="true"></span>
        <h2 id="lista-t">Quer ser avisado quando a trIA abrir?</h2>
        <p>Deixe seu contato na lista de espera. Avisamos quando houver novidades.</p>
        <a class="btn btn-claro" href={FORM_URL} target="_blank" rel="noopener">
          Entrar na lista de espera<span class="sr"> (abre o formulário em nova aba)</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="wrap rodape-in">
      <Fragment set:html={logo} />
      <p class="rodape-frase">Inteligência para criar. Clareza para ensinar. Autonomia para transformar.</p>
      <p class="rodape-mini">© {ano} trIA. ENEM é um exame do INEP; a trIA não é afiliada ao INEP.</p>
      <span class="linha-vermelha" aria-hidden="true"></span>
    </div>
  </footer>

  <Atendimento />
</Base>

<script>
  // fio sob o topo depois que a página rola
  const topo = document.querySelector('.topo');
  const marcar = () => topo?.classList.toggle('rolou', window.scrollY > 8);
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });
</script>
