---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESC, MOCKUP, GOATCOUNTER } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'trIA',
  url: new URL(`${base}/`, Astro.site).href,
  inLanguage: 'pt-BR',
  description: SITE_DESC,
});
const og = new URL(`${base}/brand/og-1200x630.png`, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{MOCKUP ? 'Site da trIA' : SITE_TITLE}</title>
    <meta name="description" content={SITE_DESC} />
    <meta name="theme-color" content="#13254A" />
    {!MOCKUP && (
      <Fragment>
        <link rel="canonical" href={canonical} />
        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
        <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href={`${base}/apple-touch-icon-180.png`} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:title" content={SITE_TITLE} />
        <meta property="og:description" content={SITE_DESC} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={og} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="trIA: questões e simulados no padrão ENEM, criados com o professor" />
        <link rel="manifest" href={`${base}/manifest.webmanifest`} />
        <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
        <script type="application/ld+json" set:html={ld} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={og} />
        {GOATCOUNTER && <script is:inline async data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <slot />
  </body>
</html>
